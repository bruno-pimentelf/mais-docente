  extraDisciplines               String[]
  contents                       UserFavoritesContent[]
  contentUsages                  UserContentUsage[]
  assignments                    Assignment[]
  ContentReport                  ContentReport[]
  contentDownloads               UserContentDownload[]
  listDownloads                  Int                              @default(0)
  classes                        Class[]                          @relation("ClassToOwner")
  type                           UserType?                        @relation(fields: [typeId], references: [id])
  typeId                         Int                              @default(1)
  student                        Student?                         @relation("UserToStudent")
  teacher                        Teacher?                         @relation("UserToTeacher")
  staff                          Staff?                           @relation("UserToStaff")
  pictureUrl                     String?                          @default("")
  backgroundUrl                  String?                          @default("")
  tutorials                      Tutorial[]
  birthdate                      DateTime?
  age                            Int?
  projects                       UserFavoritesProject[]
  projectTasks                   ProjectTask[]
  createdContents                Content[]                        @relation("contentCreator")
  classDisciplines               TeacherClassDiscipline[]
  lessons                        Lesson[]
  createdProjects                Project[]
  aiToolsResults                 AiToolResult[]
  aiToolsOutputs                 AiToolOutput[]
  newsletter                     NewsletterRecipient?
  CalendarPlan                   CalendarPlan[]
  StudyPlan                      StudyPlan[]
  activityLogs                   UserActivityLog[]
  activityLogSummary             UserActivityLogSummary[]
  verifiedContents               Content[]                        @relation("contentReviewer")
  verifiedProjects               Project[]                        @relation("contentReviewer")
  statements                     Statement[]
  ratedContents                  UserRateContent[]
  registeredSchool               RegisteredSchool?                @relation(fields: [registeredSchoolId], references: [id])
  registeredSchoolId             Int?
  followersCount                 Int                              @default(0)
  followingCount                 Int                              @default(0)
  // Lista de quem o usuário segue
