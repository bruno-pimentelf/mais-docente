  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year    Int
  week    Int
  totalXP Int @default(0)

  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, year, week])
  @@index([year, week, totalXP])
  @@index([userId, year, week])
}

model ReviewTutorInsights {
  id         String  @id @default(uuid())
  taskId     String  @unique
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bestTopic  String?
  worstTopic String?

  @@index([taskId])
}

model StudyPlan {
  id          String                  @id @default(uuid())
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  topic       String
  startDate   DateTime
  endDate     DateTime
  weekDays    CalendarPlanDayOfWeek[]
  context     String?
  grade       Grade?                  @relation(fields: [gradeId], references: [id])
  gradeId     String?
  locale      Locale?
  curriculum  String?
  color       String?
  studyDays   StudyDay[]
  classEvents ClassEvent[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model StudyDay {
  id               String            @id @default(uuid())
  studyPlan        StudyPlan         @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  studyPlanId      String
  date             DateTime
  title            String?
  topics           String[]
  description      String?
  position         Int
  studyDayContents StudyDayContent[]
  classEvent       ClassEvent?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  alreadyStudied   Boolean           @default(false)
  isPopulated      Boolean           @default(false)

  @@index([studyPlanId, date])
}

model StudyDayContent {
  id             String   @id @default(uuid())
  studyDay       StudyDay @relation(fields: [studyDayId], references: [id], onDelete: Cascade)
  studyDayId     String
  content        Content? @relation(fields: [contentId], references: [id])
  contentId      String?
  note           String?
  position       Int
  createdAt      DateTime @default(now())
  alreadyStudied Boolean  @default(false)

  @@index([studyDayId, position])
  @@index([contentId])
}

model PushSubscription {
  id           String                 @id @default(uuid())
  endpoint     String                 @unique
  p256dh       String
  auth         String
  userId       String // OBRIGATÓRIO: associar a um usuário específico
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       PushSubscriptionStatus @default(ACTIVE)
  userAgent    String? // Para debug
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  lastUsedAt   DateTime? // Última vez que foi usada com sucesso
  failureCount Int                    @default(0) // Contador de falhas consecutivas

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model AssignmentMemory {
  id                    String     @id @default(uuid())
  assignment            Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId          String     @unique
  biggestStruggleTopics String[]   @default([])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([assignmentId])
}

model ClassMemory {
  id                       String                 @id @default(uuid())
  teacherClassDiscipline   TeacherClassDiscipline @relation(fields: [teacherClassDisciplineId], references: [id], onDelete: Cascade)
  teacherClassDisciplineId String                 @unique
  commonStrengths          String[]               @default([])
  commonWeaknesses         String[]               @default([])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([teacherClassDisciplineId])
}

model GradeBookSettings {
  id                       String                  @id @default(uuid())
  teacherClassDisciplineId String?                 @unique
  teacherClassDiscipline   TeacherClassDiscipline? @relation(fields: [teacherClassDisciplineId], references: [id], onDelete: Cascade)
  groupId                  String?                 @unique
  group                    Group?                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupCalendarId          String?
  groupCalendar            GroupCalendar?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  academicTerms            AcademicTerm[]
  gradingScale             GradingScale?
  termStructure            TermStructure?
}

model AcademicTerm {
  id                  String            @id @default(uuid())
  gradeBookSettings   GradeBookSettings @relation(fields: [gradeBookSettingsId], references: [id], onDelete: Cascade)
  gradeBookSettingsId String
  name                String
  startDate           DateTime
  endDate             DateTime
}

model GradingScale {
  id                  String            @id @default(uuid())
  gradeBookSettings   GradeBookSettings @relation(fields: [gradeBookSettingsId], references: [id], onDelete: Cascade)
  gradeBookSettingsId String            @unique
  passingScore        String
  type                ScaleType
  customScores        Json?
}

model CalendarEvents {
  id              String            @id @default(uuid())
  groupCalendarId String
  groupCalendar   GroupCalendar     @relation(fields: [groupCalendarId], references: [id], onDelete: Cascade)
  type            CalendarEventType
  name            String
  startDate       DateTime
  endDate         DateTime
}

model GroupCalendar {
  id             String            @id @default(uuid())
  name           String
  groupId        String
  group          Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isPublic       Boolean
  events         CalendarEvents[]
  academicYearId String            @unique
  academicYear   GradeBookSettings @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
}

model OnlineEvent {
  id           String   @id @default(uuid())
  name         String
  description  String?
  date         DateTime
  slug         String   @unique
  audienceData Json[]
  hostsData    Json[]
  isDeleted    Boolean  @default(false)
}

model Ebook {
  id        String   @id @default(uuid())
  slug      String   @unique
  content   Json
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemonstrationSchool {
  id                String    @id @default(uuid())
  name              String
  groupId           String    @unique
  group             Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  email             String    @unique
  password          String
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  description       String?
  markedForDeletion DateTime?
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  permissions String[]
  domain      String
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?

  createdById String
  createdBy   Identity @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([tokenHash])
  @@index([isActive])
  @@map("api_tokens")
}
