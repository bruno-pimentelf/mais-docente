  badges                         UserBadges[]                     @relation("UserBadgesToUser")
  publicUrl                      String?                          @unique
  projectsUsed                   ProjectViewed[]
  questionsReviewedByDate        QuestionRevision[]
  userCertificates               UserCertificate[]
  ContentComment                 ContentComment[]
  ContentCommentUserRating       ContentCommentUserRating[]
  Presentation                   Presentation[]
  UserNotification               UserNotification[]
  UserPaidContent                UserPaidContent[]
  PaidContent                    PaidContent[]
  LessonComment                  LessonComment[]
  LessonCommentUserRating        LessonCommentUserRating[]
  Rubric                         Rubric[]
  customChatbots                 CustomChatbot[]
  flashCardProgress              UserFlashCardProgress[]
  CreditsRanking                 CreditsRanking?
  MonthlyCreditsRanking          MonthlyCreditsRanking[]
  practiceStreak                 StudentPracticeStreak?
  studentXP                      StudentXP?
  xpLogs                         StudentXPLog[]
  weeklyXP                       StudentWeeklyXP[]
  schoolRole                     String?
  manuallyAddedAssignments       ManualAssignment[]
  data                           Json?
  guardianAccessStudent          GuardianAccess[]                 @relation("student_to_user")
  guardianAccessGuardian         GuardianAccess[]                 @relation("guardian_to_user")
  materialThemeId                String?
  materialTheme                  MaterialTheme?                   @relation("MaterialThemeToUser")
  StudentCluster                 StudentCluster[]
  slug                           String?                          @unique
  pushSubscriptions              PushSubscription[]
  reviewedLessons                Lesson[]                         @relation("LessonSchoolReviewer")
  reviewedContent                Content[]                        @relation("ContentSchoolReviewer")
  QuestionSkillLog               QuestionSkillLog[]
  laraCustomization              Json?
  demonstrationSchools           DemonstrationSchool[]

  @@index([ownerId])
