// Auth.JS

model Account {
  id                String    @id @default(cuid())
  type              String?
  providerAccountId String    @map("providerAccountId")
  refreshToken      String?   @map("refresh_token") @db.Text
  accessToken       String?   @map("access_token") @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?   @map("id_token") @db.Text
  sessionState      String?
  user              Identity? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String?

  providerId            String?   @map("provider")
  refreshTokenExpiresAt DateTime?
  password              String?
  createdAt             DateTime? @default(now())
  updatedAt             DateTime? @updatedAt

  accessTokenExpiresAt DateTime?

  accountId String?

  @@unique([providerId, providerAccountId])
  @@index([userId])
}

model Identity {
  id                    String                  @id @default(uuid())
  name                  String?
  image                 String?
  email                 String                  @unique
  isGhost               Boolean                 @default(false)
  emailVerified         DateTime?
  authEmailVerified     Boolean                 @default(false)
  password              String?
  accounts              Account[]
  consentTimestamp      DateTime?
  referralCode          ReferralCode?           @relation("IdentityToReferralCode")
  referralsMade         Referral[]              @relation("ReferrerToReferrals")
  referralReceived      Referral?               @relation("ReferredToReferral")
  coupons               Coupon[]
  bonuses               BonusLimit[]
  workspaces            User[]                  @relation("WorkspaceOwner")
  IdentitySharedClass   IdentitySharedClass[]
  credits               Int                     @default(0)
  creditsLog            CreditsLog[]
  createdAt             DateTime?
  updatedAt             DateTime?
  sessions              Session[]
  role                  String?
  banned                Boolean?
  banReason             String?
  banExpires            DateTime?
  CreditsRanking        CreditsRanking[]
  MonthlyCreditsRanking MonthlyCreditsRanking[]
  apiTokens             ApiToken[]
}

enum TokenType {
  EmailConfirmation
  // PasswordReset
  DeleteAccount
}

model VerificationToken {
  id        String    @id @default(uuid())
  email     String    @unique
  token     String    @unique
  expires   DateTime
  createdAt DateTime  @default(now())
  tokenType TokenType @default(EmailConfirmation)

  @@unique([email, token, tokenType])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

