  groupPostsRatings              GroupPostUserRating[]
  groupPostsComments             GroupPostComment[]               @relation("CommentOwner")
  groupPostsCommentsRatings      GroupPostCommentUserRating[]
  postOnboardingUseDates         DateTime[]
  npsScores                      NPSScore[]
