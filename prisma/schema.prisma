}

model ContentInteraction {
  id        String                       @id @default(uuid())
  userId    String?
  User      User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  contentId String?
  Content   Content?                     @relation(fields: [contentId], references: [id])
  source    ContentRecommendationSource? // where the recommendation/impression actually happened
  page      Int? // page where the content was interacted with

  contentPosition Int
  lessonData      Json? // data like "title", lessonId, ids of contents in lesson, etc
  serpList        String[] // lista de id's de conteudos que foram mostrados na mesma recomendação
  eventType       ContentInteractionType
  timestamp       DateTime               @default(now())
}

model ContentInteractionStats {
  id          String  @id @default(uuid())
  content     Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId   String  @unique
  positive    Int     @default(0)
  negative    Int     @default(0)
  impressions Int     @default(0)
  needsUpdate Boolean @default(false)
}

model Content {
  id                      String                   @id @default(uuid())
  title                   String
  description             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  type                    ContentType
  categories              Category[]
  verified                Boolean?                 @default(false)
  public                  Boolean?                 @default(false)
  hidden                  Boolean?                 @default(false)
  isDeleted               Boolean                  @default(false)
  isGenerating            Boolean                  @default(false)
  failedThumbnail         Boolean                  @default(false)
  sentToWorkerAt          DateTime?
  section                 ContentSection
  LinkContent             LinkContent?
  VideoContent            VideoContent?
  MarkdownContent         MarkdownContent?
  FileContent             FileContent?
  FileDriveContent        FileDriveContent?
  HtmlContent             HtmlContent?
  ListContent             List?
  ProjectContent          Project?
  PresentationContent     Presentation?
  InteractiveGameContent  InteractiveGameContent?
  users                   UserFavoritesContent[]
  usageBy                 UserContentUsage[]
  ContentReport           ContentReport[]
  ContentAttribution      ContentAttribution?
  schoolId                String?
  school                  Group?                   @relation(fields: [schoolId], references: [id])
  user                    User?                    @relation("contentCreator", fields: [userId], references: [id])
  userId                  String?
  aiModels                AiModel[]
  tasks                   Task[]
  ownerType               ContentOwnerType
  external                Boolean                  @default(false)
  lessonContents          LessonContent[]
  studyDayContents        StudyDayContent[]
  priority                Int                      @default(0)
  reviewer                User?                    @relation("contentReviewer", fields: [reviewerId], references: [id])
  reviewerId              String?
  lessonMethodology       LessonMethodology?
  practices               Practice[]
  contentRatings          UserRateContent[]
  rate                    Float                    @default(0)
  usageCount              Int                      @default(0)
  thumbnail               String?
  thumbnailTimestamp      DateTime?
  translatedContents      Content[]                @relation("TranslationRelation")
  originalContent         Content?                 @relation("TranslationRelation", fields: [originalContentId], references: [id])
  originalContentId       String?
  contentInteractionStats ContentInteractionStats?
  positiveScore           Float                    @default(0)
  ContentInteraction      ContentInteraction[]
  posts                   GroupPost[]
  locale                  Locale?
  communityPosts          CommunityPost[]
  communityPostComments   CommunityPostComment[]
  comments                ContentComment[]         @relation("ContentComments")
  qualityScore            Float                    @default(0)
  AiToolResult            AiToolResult?            @relation("ContentAiToolResult", fields: [aiToolResultId], references: [id])
  aiToolResultId          String?                  @unique
  AiToolOutput            AiToolOutput?            @relation("ContentAiToolOutput", fields: [aiToolOutputId], references: [id])
  aiToolOutputId          String?                  @unique
  origin                  ContentOrigin?
  originalAiToolSlug      String?
  chosenLanguage          String?
  keyWords                String[]                 @default([])
  topic                   String?
  PaidContent             PaidContent?
  isPaid                  Boolean                  @default(false)
  LessonComment           LessonComment[]
  customChatbot           CustomChatbot?
  customChatbotId         String?                  @unique
  grade                   Grade?                   @relation(fields: [gradeId], references: [id])
  gradeId                 String?
  auditorStatus           AuditorStatus?
  disciplineId            String?
  discipline              Discipline?              @relation(fields: [disciplineId], references: [id])
  isIndexable             Boolean                  @default(false)
  schoolReviewStatus      ReviewStatus             @default(NOT_REVIEWED)
  schoolReviewUpdatedAt   DateTime                 @default(now())
  schoolReviewUpdatedById String?
  schoolReviewUpdatedBy   User?                    @relation("ContentSchoolReviewer", fields: [schoolReviewUpdatedById], references: [id], onDelete: SetNull)

  @@index([qualityScore])
  @@index([userId, isDeleted, updatedAt(sort: Desc)], name: "idx_content_userid_isdeleted_updatedat")
  @@index([public, isDeleted, hidden, ownerType, section, thumbnail(sort: Desc), rate(sort: Desc), locale], name: "idx_content_materials_balanced")
  @@index([schoolReviewUpdatedById])
}

model UserRateContent {
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
  rating    Int
  type      UserRateContentType @default(LIKE)

  @@id([userId, contentId])
  @@index([contentId])
}

model UserContentDownload {
  id                 String            @id @default(uuid())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  markdownContent    MarkdownContent?  @relation(fields: [markdownContentId], references: [id])
  markdownContentId  String?
  fileContent        FileContent?      @relation(fields: [fileContentId], references: [id])
  fileContentId      String?
  fileDriveContent   FileDriveContent? @relation(fields: [fileDriveContentId], references: [id])
  fileDriveContentId String?
  htmlContent        HtmlContent?      @relation(fields: [htmlContentId], references: [id])
  htmlContentId      String?
  createdAt          DateTime          @default(now())
  bonusLimit         BonusLimit?       @relation(fields: [bonusLimitId], references: [id])
  bonusLimitId       String?
}

model ContentReport {
  id          String   @id @default(uuid())
  description String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime @default(now())
  modifiedAt  DateTime @updatedAt
  solved      Boolean? @default(false)
  archived    Boolean? @default(false)
}

model ContentAttribution {
  id          String  @id @default(uuid())
  licenseSlug String
  license     License @relation(fields: [licenseSlug], references: [slug])
  title       String?
  author      String?
  source      String?
  description String?
  date        String?
  content     Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId   String  @unique
}

model License {
  id                 String               @id @default(uuid())
  slug               String               @unique
  name               String
  url                String?
  ContentAttribution ContentAttribution[]
}

model UserFavoritesContent {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String
  createdAt DateTime @default(now())

  @@id([userId, contentId])
}

model LinkContent {
  id        String  @id @default(uuid())
  url       String
  pageTitle String?
  imageURL  String?
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String  @unique
}

model VideoContent {
  id         String  @id @default(uuid())
  url        String
  thumbnail  String?
  videoTitle String?
  content    Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId  String  @unique
