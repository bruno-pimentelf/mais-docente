  updatedAt                      DateTime                         @updatedAt
  state                          String?
  phoneNumber                    String?
  studentAmount                  Int?
  subscription_id                String?
  subscription_provider          PaymentProvider?
  subscription_started_at        DateTime?
  subscription_ended_at          DateTime?
