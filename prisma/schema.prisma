  // Lista de seguidores do usuário
  followers                      Follow[]                         @relation("UserFollowed")
  achievments                    UserAchievment[]
  goals                          UserGoal[]                       @relation("UserGoalsToUser")
  // Grupo(Escola) ao qual o usuário pertence
  userGroup                      UserGroup?                       @relation("UserGroupToUser")
  userGroupId                    String?
  // Convites para grupos (enviados ou recebidos)
  groupInvitations               GroupInvitation[]
  // Grupo que o usuário criou
