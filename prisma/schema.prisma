  contentId      String                @unique
  fileSize       Int                   @default(0)
  downloads      UserContentDownload[]
  slug           String?               @unique
  originalGCPUrl String?
}

model HtmlContent {
  id        String                @id @default(uuid())
  url       String?
  content   Content               @relation(fields: [contentId], references: [id])
  contentId String                @unique
  fileSize  Int                   @default(0)
  downloads UserContentDownload[]
}

enum CategoryType {
  GENERIC
  SPECIFIC
}

enum ContentOrigin {
  AI_TOOLS
  ONLINE_GENERATION
  OFFLINE_GENERATION
  UPLOAD
}

enum Extension {
  PDF
  PRESENTATION
  DOCUMENT
  SPREADSHEET
  IMAGE
  AUDIO
  VIDEO
  OTHER
}

enum ContentSection {
  LESSON_PLAN
  SUMMARY
  PRESENTATION
  ASSIGNMENT
  QUESTIONS
  LIST
  MIND_MAP
  WORD_SEARCH
  CROSSWORD
  ACTIVITY
  EMAIL
  ESSAY_THEME
  GAME
  IDEAS
  IMAGE
  INSTRUCTIONAL_SEQUENCE
  LEARNING_OBJECTIVES
  LEARNING_PLAN
  MESSAGE
  PROJECT
  REPORT
  RUBRIC
  SONG
  TABLE
  ARTICLE
  TEXTUAL_SUPPORT
  VOCABULARY
  BOOK
  VIDEO_LESSON
  LESSON
  APP
  TOOL
  REVIEW_BOT
  OTHER
}

model UserType {
  id      Int                    @id @default(autoincrement())
  name    String                 @unique
  type    UserTypeClassification @unique
  users   User[]
  aiTools AiTool[]
}

model TeacherClassDiscipline {
  id                String             @id @default(uuid())
  teacherId         String
  teacher           User               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  disciplineId      String?
  discipline        Discipline?        @relation(fields: [disciplineId], references: [id])
  customDiscipline  String?
  classId           String
  class             Class              @relation(fields: [classId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tasks             Task[]
  studentMemories   StudentMemory[]
  classMemory       ClassMemory?
  gradeBookSettings GradeBookSettings?

  @@unique([classId, teacherId, disciplineId])
  @@index([classId])
}

model Class {
  id                       String                   @id @default(uuid())
  name                     String                   @db.VarChar(255)
  description              String?                  @db.VarChar(255)
  studentCapacity          Int
  gradeId                  String?                  @db.Text
  disciplineId             String?                  @db.Text
  customGrade              String?                  @db.Text
  customDiscipline         String?                  @db.Text
  registrationCode         String?                  @unique @db.VarChar(50)
  creatorId                String?                  @db.Text
  groupId                  String?
  createdAt                DateTime                 @default(now()) @db.Timestamp(3)
  updatedAt                DateTime                 @default(now()) @db.Timestamp(3)
  isArchived               Boolean                  @default(false)
  isDeleted                Boolean                  @default(false)
  grade                    Grade?                   @relation(fields: [gradeId], references: [id])
  creator                  User?                    @relation("ClassToOwner", fields: [creatorId], references: [id])
  // O grupo que é dono da turma, não mais um professor
  group                    Group?                   @relation("ClassToGroup", fields: [groupId], references: [id])
  students                 StudentClass[]
  assignments              AssignmentClass[]
  projectTaskClasses       ProjectTaskClass[]
  CalendarPlan             CalendarPlan[]
  statements               Statement[]
  // Grupos aos quais a turma foi compartilhada
  groupsSharedWith         GroupSharedClass[]
  // Pessoas as quais a turma foi compartilhada
  identitiesSharedWith     IdentitySharedClass[]
  // Usuário que compartilhou a turma
  sharedFromUser           User?                    @relation("SharedClassToUser", fields: [sharedFromUserId], references: [id], onDelete: SetNull)
  sharedFromUserId         String?
  lessons                  LessonClass[]
  Attendance               Attendance[]
  teachers                 TeacherClassDiscipline[]
  invitations              ClassInvitation[]
  calendarPlanTimes        CalendarPlanTime[]
  classEvents              ClassEvent[]
  aiTools                  ClassAiTools[]
  manuallyAddedAssignments ManualAssignmentClass[]
  studentClusters          StudentCluster[]

  @@index([groupId, isDeleted])
}

// Aluno Freemium ou de Escola

model Student {
  id                    String                  @id @map("id")
  user                  User                    @relation("UserToStudent", fields: [id], references: [id], onDelete: Cascade)
  classes               StudentClass[]
  Attempt               Attempt[]
  financialResponsible  String?
  tasks                 StudentTask[]
  practices             Practice[]
  practiceResolutions   PracticeResolution[]
  guardians             Guardian[]
  practiceEvents        PracticeEvent[]
  practicePlans         PracticePlan[]
  Attendance            Attendance[]
  assignmentPerStudents AssignmentPerStudent[]
  classInvitations      ClassInvitation[]
  ManualAssignmentGrade ManualAssignmentGrade[]
  isAutoGrade           Boolean?                @default(false)
  studentClusters       StudentCluster[]
  memories              StudentMemory[]
  schoolMemories        SchoolStudentMemory[]
}

// Student Cluster

model StudentCluster {
  id       String    @id @default(uuid())
  name     String    @db.VarChar(255)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId  String
  students Student[]
  tasks    Task[]
}

// Professor Freemium ou de Escola

model Teacher {
  id            String  @id @map("id")
  user          User    @relation("UserToTeacher", fields: [id], references: [id], onDelete: Cascade)
  workingSchool String?
  isAmbassador  Boolean @default(false)
}

// Líder escolar que gerencia uma escola matriz/filial

model Staff {
  id   String @id @map("id")
  user User   @relation("UserToStaff", fields: [id], references: [id], onDelete: Cascade)
}

model Guardian {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String
  students  Student[]
  createdAt DateTime  @default(now())
}

// Turmas que os alunos está matriculado

model StudentClass {
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  class       Class              @relation(fields: [classId], references: [id])
  classId     String
  status      StudentClassStatus @default(PENDING)
  report      String?
  studentName String?

  @@unique([studentId, classId])
  @@index([classId, studentId])
}

model StudentMemory {
  id                String   @id @default(uuid())
  bio               String?
  weaknesses        String[]
  strengths         String[]
  commentsForFamily String?

  // Scope
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  // When set, this memory is specific to a class; when null, it's the single "global" memory
  class   TeacherClassDiscipline? @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Prevent duplicate class-scoped memories for the same (student, class)
  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
}

model SchoolStudentMemory {
  id                String   @id @default(uuid())
  bio               String?
  weaknesses        String[]
  strengths         String[]
  commentsForFamily String?

  // Scope
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  // School scope
  school  Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}

// Turmas que uma avaliação deverá ser aplicada

model AssignmentClass {
  assignment          Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId        String
  class               Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId             String
  isDeleted           Boolean    @default(false)
  weight              Float?
  includeInFinalGrade Boolean    @default(true)

  @@unique([assignmentId, classId])
  @@index([classId, isDeleted, includeInFinalGrade])
  @@index([assignmentId])
}

model Attendance {
  id         String   @id @default(uuid())
  date       DateTime
  wasPresent Boolean  @default(true)
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, date, studentId])
}

model ReferralCode {
  id         String   @id @default(uuid())
  identityId String   @unique
  identity   Identity @relation("IdentityToReferralCode", fields: [identityId], references: [id], onDelete: Cascade)
  code       String?  @unique
  createdAt  DateTime @default(now())
}

model GroupReferralCode {
  id        String   @id @default(uuid())
  groupId   String   @unique
  group     Group    @relation("GroupToReferralCode", fields: [groupId], references: [id], onDelete: Cascade)
  code      String?  @unique
  createdAt DateTime @default(now())
}

model BonusLimit {
  id                    String                @id @default(uuid())
  identity              Identity              @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId            String
  totalAmount           Int
  usedAmount            Int                   @default(0)
  actionType            ActionType
  createdAt             DateTime              @default(now())
  startDate             DateTime              @default(now())
  endDate               DateTime?
  isDeleted             Boolean               @default(false)
  contentDownloads      UserContentDownload[]
  ReferrerBonusReferral Referral?             @relation("ReferrerBonusToReferral")
  ReferredBonusReferral Referral?             @relation("ReferredBonusToReferral")
}

model Task {
  id                  String                   @id @default(uuid())
  title               String
  description         String?
  createdAt           DateTime                 @default(now())
  modifiedAt          DateTime                 @updatedAt
  type                TaskType
  content             Content?                 @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId           String?
  assignment          Assignment?              @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId        String?                  @unique
  projectTask         ProjectTask?             @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)
  projectTaskId       String?                  @unique
  list                List?                    @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId              String?
  dueDate             DateTime?
  scheduledDate       DateTime?                @default(now())
  isDeleted           Boolean                  @default(false)
  isSent              Boolean                  @default(false)
  classification      TaskClassification
  studentTasks        StudentTask[]
  studentClusters     StudentCluster[]
  classes             TeacherClassDiscipline[]
  reviewTutorInsights ReviewTutorInsights?

  @@index([listId])
}

model StudentTask {
  task                  Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId                String
  student               Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId             String
  isCompleted           Boolean                 @default(false)
  attempts              Attempt[]
  isDeleted             Boolean                 @default(false)
  ProjectTaskResolution ProjectTaskResolution[]
  bestTopic             String?
  worstTopic            String?

  @@unique([taskId, studentId])
  @@index([studentId])
}

// Estilos de simulados
// Temos os estilos nativos (Enem, Fuvest, etc), e os criados pelo usuário
// Essa tabela guarda os filtros de cada estilo. Então por exemplo, para o estilo Enem
// temos dificuldade minima de 0 e maxima de 800, answerType do tipo multipla escolha, etc
// Quando o usuário seleciona o estilo do simulado, esses valores sao utilizados
// para aplicar os filtros automaticamente

model MockExamType {
  id            String                   @id @default(uuid())
  name          String
  minDifficulty Int                      @default(0)
  maxDifficulty Int                      @default(1000)
  answerTypes   AnswerType[]
  grades        Grade[]
  disciplines   DisciplineMockExamType[]
  tag           Tag?                     @relation(fields: [tagId], references: [id])
  tagId         String?
  source        Source                   @relation(fields: [sourceId], references: [id])
  sourceId      String
}

model EntranceExamType {
  id          String       @id @default(uuid())
  name        String
  disciplines Discipline[]
  tag         Tag?         @relation(fields: [tagId], references: [id])
  tagId       String?
  source      Source       @relation(fields: [sourceId], references: [id])
  sourceId    String
  countryCode String?      @default("BR")
}

// Numero de questões por disciplina pra um estilo de prova

model DisciplineMockExamType {
  discipline        Discipline   @relation(fields: [disciplineId], references: [id])
  disciplineId      String
  mockExamType      MockExamType @relation(fields: [mockExamTypeId], references: [id])
  mockExamTypeId    String
  numberOfQuestions Int

  @@id([disciplineId, mockExamTypeId])
}

enum LessonContentType {
  CONTENT
  NOTE
}

enum LessonType {
  LESSON
  ASSIGNMENT
}

model LessonContent {
  id              String            @id @default(uuid())
  type            LessonContentType @default(CONTENT)
  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId        String
  content         Content?          @relation(fields: [contentId], references: [id])
  contentId       String?
  note            String?
  position        Int
  lessonSection   LessonSection?    @relation(fields: [lessonSectionId], references: [id], onDelete: Cascade)
  lessonSectionId String?

  @@index([lessonSectionId, id])
  @@index([lessonSectionId])
  @@index([lessonId])
  @@index([contentId])
}

model LessonSection {
  id           String          @id @default(uuid())
  lesson       Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String
  title        String
  body         Json
  bodyUnparsed Json?           @default("{}")
  position     Int
  contents     LessonContent[]

  // Add this if you frequently query sections by position within a lesson
  @@index([lessonId])
  @@index([lessonId, id])
  @@index([lessonId, position])
}

model Lesson {
  id                      String                 @id @default(uuid())
  name                    String
  keyWords                String[]               @default([])
  topic                   String                 @default("")
  context                 String?
  learningObjectives      String?
  discipline              Discipline?            @relation(fields: [disciplineId], references: [id])
  disciplineId            String?
  disciplineName          String?
  categories              Category[]
  categoryText            String?
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String
  createdAt               DateTime               @default(now())
  modifiedAt              DateTime               @updatedAt
  isDeleted               Boolean                @default(false)
  isArchived              Boolean                @default(false)
  isFixed                 Boolean                @default(false)
  public                  Boolean                @default(true)
  classEvent              ClassEvent?
  classes                 LessonClass[]
  shouldGenerate          Boolean                @default(false)
  groupPosts              GroupPost[]
  CommunityPost           CommunityPost[]
  CommunityPostComment    CommunityPostComment[]
  lessonContents          LessonContent[]
  sections                LessonSection[]
  skills                  Skill[]
  viewCount               Int                    @default(0)
  gradeId                 String?
  grade                   Grade?                 @relation(fields: [gradeId], references: [id])
  methodology             LessonMethodology?     @default(Active)
  type                    LessonType             @default(LESSON)
  duplications            LessonDuplication[]
  slug                    String?                @unique
  locale                  Locale?
  LessonComment           LessonComment[]
  fileUrls                String[]
  selectedBlocks          String[]               @default([])
  thumbnailUrl            String?
  duplicationsCount       Int                    @default(0)
  schoolReviewStatus      ReviewStatus           @default(NOT_REVIEWED)
  schoolReviewUpdatedAt   DateTime               @default(now())
  schoolReviewUpdatedById String?
  schoolReviewUpdatedBy   User?                  @relation("LessonSchoolReviewer", fields: [schoolReviewUpdatedById], references: [id], onDelete: SetNull)

  @@index([userId, modifiedAt])
  @@index([viewCount])
  @@index([schoolReviewUpdatedById])
}

model LessonClass {
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId  String
  isSent   Boolean? @default(false)

  @@unique([lessonId, classId])
}

model ClassAiTools {
  id          String  @id @default(uuid())
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId     String
  aiTool      AiTool  @relation(fields: [aiToolId], references: [id], onDelete: Cascade)
  aiToolId    String
  isAvailable Boolean @default(false)

  @@unique([classId, aiToolId])
}

model CustomChatbot {
  id           String         @id @default(uuid())
  customPrompt String
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  results      AiToolResult[] @relation("CustomChatbotResults")
  content      Content?       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId    String?        @unique

  @@index([userId])
}

model AiTool {
  id                   String                 @id @default(uuid())
  title                String
  description          String
  slug                 String                 @unique
  priority             Int                    @default(0)
  type                 AiToolType
  fields               AiToolField[]
  modifiers            AiToolModifier[]
  isDeleted            Boolean                @default(false)
  aiToolsResults       AiToolResult[]
  userTypes            UserType[]
  favoritedBy          User[]
  toolsRecommendations AiToolRecommendation[]
  classAiTools         ClassAiTools[]
}

model AiToolField {
  id             String              @id @default(uuid())
  toolId         String
  tool           AiTool              @relation(fields: [toolId], references: [id], onDelete: Cascade)
  type           AiToolFieldType
  name           String
  initialValue   String              @default("")
  label          String
  isOptional     Boolean             @default(false)
  isExperimental Boolean             @default(false)
  placeholder    String              @default("")
  inputs         AiToolResultInput[]
  showLabel      Boolean?            @default(true)

  @@unique([toolId, name])
}

model AiToolModifier {
  id        String         @id @default(uuid())
  tools     AiTool[]
  title     String
  slug      String         @unique
  priority  Int            @default(0)
  outputs   AiToolOutput[]
  isDeleted Boolean        @default(false)
}

model AiToolResult {
  id              String                  @id @default(uuid())
  toolId          String
  tool            AiTool                  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  inputs          AiToolResultInput[]
  outputs         AiToolOutput[]
  content         Content?                @relation("ContentAiToolResult")
  language        Language
  createdAt       DateTime                @default(now())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDeleted       Boolean                 @default(false)
  customChatbot   CustomChatbot?          @relation("CustomChatbotResults", fields: [customChatbotId], references: [id])
  customChatbotId String?
  sessionInsights ChatbotSessionInsight[]
  engagementLevel EngagementLevel?

  @@index([userId])
  @@index([userId, isDeleted, createdAt])
}

model ChatbotSessionInsight {
  id          String                    @id @default(uuid())
  sessionId   String
  session     AiToolResult              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  insight     String
  insightType ChatbotSessionInsightType
}

enum AiToolOrigin {
  HOME
  CHATBOT_PAGE
}

model AiToolOutput {
  id                    String                 @id @default(uuid())
  output                String
  outputOnResult        AiToolResult?          @relation(fields: [outputOnResultId], references: [id])
  outputOnResultId      String?
  modifierUsed          AiToolModifier?        @relation(fields: [modifierUsedId], references: [id])
  modifierUsedId        String?
  modifierLanguage      Language?
  modifierInputValue    String?
  modifierInputImages   String[]
  outputImageUrl        String?
  inputFileNames        String[]
  cost                  Float?
  origin                AiToolOrigin?
  createdAt             DateTime               @default(now())
  isSavedAsContent      Boolean                @default(false)
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating                Rating?
  feedbacks             AiToolFeedback[]
  searchOutputs         AiToolSearchOutput[]
  featureOutputs        FeatureOutput[]
  featureSuggestion     String?
  featureSuggestionType FeatureSuggestionType?
  content               Content?               @relation("ContentAiToolOutput")

  @@index([outputOnResultId])
}

model FeatureOutput {
  id             String       @id @default(uuid())
  slug           String
  topic          String
  AiToolOutput   AiToolOutput @relation(fields: [aiToolOutputId], references: [id], onDelete: Cascade)
  aiToolOutputId String
}

model AiToolSearchOutput {
  id            String         @id
  attributeType AttributeType
  aiToolOutputs AiToolOutput[]
  external      Boolean        @default(false)
  score         Float          @default(0)
  title         String?
  url           String?
  icon          String?
}

model AiToolFeedback {
  id        String       @id @default(uuid())
  outputId  String
  output    AiToolOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  feedback  String
  rating    Rating
  createdAt DateTime     @default(now())
}

model AiToolResultInput {
  aiToolResultId String
  aiToolResult   AiToolResult @relation(fields: [aiToolResultId], references: [id], onDelete: Cascade)
  fieldId        String
  field          AiToolField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value          String

  @@id([aiToolResultId, fieldId])
}

model NewsletterRecipient {
  id         String     @id @default(uuid())
  firstName  String
  lastName   String
  email      String     @unique
  phone      String?
  profession Profession
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?    @unique
  createdAt  DateTime   @default(now())
}

model ScriptExecution {
  id         Int      @id @default(autoincrement())
  scriptName String
  executedAt DateTime @default(now())
  failed     Boolean
  errorLog   String?
}

model CalendarPlan {
  id                          String                       @id @default(uuid())
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                      String
  year                        Int?
  startDate                   DateTime
  endDate                     DateTime
  context                     String?
  vacationStartDate           DateTime?
  vacationEndDate             DateTime?
  includeNationalHolidays     Boolean                      @default(false)
  className                   String?
  grade                       Grade?                       @relation(fields: [gradeId], references: [id])
  gradeId                     String?
  class                       Class?                       @relation(fields: [classId], references: [id])
  classId                     String?
  discipline                  Discipline?                  @relation(fields: [disciplineId], references: [id])
  disciplineId                String?
  customDiscipline            String?
  googleCalendarId            String?
  calendarPlanUnavailableDays CalendarPlanUnavailableDay[]
  calendarPlanTimes           CalendarPlanTime[]
  classEvents                 ClassEvent[]
  color                       String?
  isGenerating                Boolean                      @default(false)
  data                        Json?
  status                      String?
}

model CalendarPlanUnavailableDay {
  id                    String                         @id @default(uuid())
  date                  DateTime
  calendarPlan          CalendarPlan                   @relation(fields: [calendarPlanId], references: [id], onDelete: Cascade)
  calendarPlanId        String
  type                  CalendarPlanUnavailableDayType
  startTime             DateTime?
  endTime               DateTime?
  googleCalendarEventId String?
}

model CalendarPlanTime {
  id             String                @id @default(uuid())
  calendarPlan   CalendarPlan?         @relation(fields: [calendarPlanId], references: [id], onDelete: Cascade)
  calendarPlanId String?
  day            CalendarPlanDayOfWeek
  slotsAmount    Int                   @default(1)
  ClassEvent     ClassEvent[]
  class          Class?                @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId        String?
  user           User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
}

model ClassEvent {
  id                    String             @id @default(uuid())
  calendarPlanTime      CalendarPlanTime?  @relation(fields: [calendarPlanTimeId], references: [id])
  calendarPlanTimeId    String?
  calendarPlan          CalendarPlan?      @relation(fields: [calendarPlanId], references: [id], onDelete: Cascade)
  calendarPlanId        String?
  studyPlan             StudyPlan?         @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  studyPlanId           String?
  date                  DateTime
  lesson                Lesson?            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId              String?            @unique
  studyDay              StudyDay?          @relation(fields: [studyDayId], references: [id], onDelete: Cascade)
  studyDayId            String?            @unique
  categoriesDuration    CategoryDuration[]
  googleCalendarEventId String?
  class                 Class?             @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId               String?
  user                  User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String?
  methodology           LessonMethodology?
  position              Int?

  @@index([userId, date(sort: Asc)])
  @@index([calendarPlanTimeId])
}

model CategoryDuration {
  classEvent   ClassEvent @relation(fields: [classEventId], references: [id], onDelete: Cascade)
  classEventId String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  duration     Float
  position     Int

  @@id([classEventId, categoryId])
  @@unique([classEventId, position])
}

enum FeatureSuggestionType {
  ANSWER_AND_ASK
  JUST_ASK
  EXECUTE
}

// Tipos de elementos que podem ser logados (lista, vídeo, projeto etc.)

enum ElementType {
  // Ações da conta (registro/CREATE, login/USE, atualizar perfil/UPDATE, excluir conta/DELETE, convidar usuário/INVITE)
  LOGIN
  USER
  // Turma (criação/CREATE, edição/UPDATE, exclusão/DELETE, compartilhar/SHARE, convidar aluno/INVITE, atribuir professor/ASSIGN, entrar na turma/JOIN, sair da turma/LEAVE etc.)
  CLASSROOM
  // Ações de questões (criação/CREATE, edição/UPDATE, exclusão/DELETE, usar numa lista/USE, compartilhar etc.)
  QUESTION
  DISCURSIVE_QUESTION
  PRACTICE
  STUDY_PLAN
  LIST
  ASSIGNMENT
  PROJECT
  PROJECT_TASK
  MOCK_EXAM
  LESSON
  AI_TOOL
  LIST_ANSWER
  CHATBOT
  // Grupo (criação/CREATE, edição/UPDATE, exclusão/DELETE, compartilhar/SHARE, convidar usuário/INVITE, atribuir permissões/ASSIGN, entrar no grupo/JOIN, sair do grupo/LEAVE etc.)
  GROUP
  // Postagens do grupo (postar/CREATE, edição/UPDATE, exclusão/DELETE, compartilhar/SHARE, comentar/COMMENT, curtir/LIKE etc.)
  GROUP_FEED
  // Conteúdos
  LINK
  VIDEO
  MARKDOWN
  FILE
  LESSON_PLAN
  ESSAY_THEME
  // Fim de Conteúdos
}

// Tipos de ações que podem ser logadas (criação, edição, exclusão, download, compartilhar etc.)

enum ElementActionType {
  CREATE
  READ
  UPDATE
  DELETE
  GENERATE_WITH_MAGIC
  USE
  JOIN
  LEAVE
  DOWNLOAD
  SHARE
  UNSHARE
  DUPLICATE
  INVITE
  ASSIGN
  UNASSIGN
  LIKE
  DISLIKE
  FAVORITE
  UNFAVORITE
  COMMENT
  START
  FINISH
  FOLLOW
  UNFOLLOW
  AUTOMATIC_CORRECTION
  REACHED_LIMIT
  REQUEST_TO_JOIN
  ACCEPT_INVITATION
  REJECT_INVITATION
  ACCEPT_REQUEST
  REJECT_REQUEST
  REMOVE_USER
  ACCEPT_SHARED
  REJECT_SHARED
  UPDATE_USER_PROFILE
  FILL_WITH_AI
}

// Log das atividades do usuário

model UserActivityLog {
  id                String            @id @default(uuid())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  // Qual o tipo de elemento que foi acessado (login, questão, lista, vídeo, projeto etc.)
  elementType       ElementType
  // Qual o tipo de ação que foi realizada (criação, edição, exclusão, download, compartilhar etc.)
  elementActionType ElementActionType
  // Qual elemento está envolvido no log
  elementId         String?
  createdAt         DateTime          @default(now())
  deletedAt         DateTime?

  // @@unique([userId, elementType, elementActionType, elementId])
  @@index([userId], name: "userActivityLogUserIdIndex")
  @@index([elementType], name: "userActivityLogElementTypeIndex")
  @@index([elementActionType], name: "userActivityLogElementActionTypeIndex")
}

// Compilado de atividades do usuário

model UserActivityLogSummary {
  id                String            @id @default(uuid())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  elementType       ElementType
  elementActionType ElementActionType
  count             Int
  updatedAt         DateTime          @updatedAt

  @@unique([userId, elementType, elementActionType])
  @@index([userId], name: "userActivityLogSummaryUserIdIndex")
  @@index([elementType], name: "userActivityLogSummaryElementTypeIndex")
  @@index([elementActionType], name: "userActivityLogSummaryElementActionTypeIndex")
}

// Conquistas que usuários podem conquistar

model Achievment {
  id                String            @id @default(uuid())
  title             String
  description       String
  iconUrl           String
  points            Int
  elementType       ElementType
  elementActionType ElementActionType
  userAchievments   UserAchievment[]
  createdAt         DateTime          @default(now())
}

// Conquistas que usuários conquistaram

model UserAchievment {
  id           String     @id @default(uuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  achievment   Achievment @relation(fields: [achievmentId], references: [id], onDelete: Cascade)
  achievmentId String
  createdAt    DateTime   @default(now())
}

// Grupos que usuários podem criar em comunidades

model Group {
  id                   String                   @id @default(uuid())
  name                 String
  pictureUrl           String?
  isPublic             Boolean                  @default(true)
  // Plano do grupo (FREE, PREMIUM, ENTERPRISE)
  plan                 GroupPlan                @default(FREE)
  users                UserGroup[]              @relation("UserGroupToGroup")
  creator              User                     @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId            String
  createdAt            DateTime                 @default(now())
  // Escola registrada associada ao Grupo de Usuários
  registeredSchool     RegisteredSchool?        @relation(fields: [registeredSchoolId], references: [id])
  registeredSchoolId   Int?
  // Turmas criadas no grupo (Disponível para todos os admins verem e poderem atribuir a professores)
  classes              Class[]                  @relation("ClassToGroup")
  // Turmas compartilhadas no grupo
  sharedClasses        GroupSharedClass[]
  // Cada grupo pode ter vários convites
  invitations          GroupInvitation[]
  GroupPost            GroupPost[]
  // Solicitações de validação de grupos
  validationRequests   GroupValidationRequest[]
  referralCode         GroupReferralCode?       @relation("GroupToReferralCode")
  isGuardianReferralOn Boolean                  @default(false)
  Content              Content[]
  schoolWebSite        SchoolWebSite?
  materialThemeId      String?
  materialTheme        MaterialTheme?           @relation("MaterialThemeToGroup")
  GroupCalendar        GroupCalendar[]
  gradeBookSettingsId  String?
  gradeBookSettings    GradeBookSettings?
  // relação 1-1 (cada group tem um conjunto de parâmetros de IA)
  AiConfiguration      AiConfiguration?
  demonstrationSchool  DemonstrationSchool?

  // School-wide student memories
  schoolStudentMemories SchoolStudentMemory[]

  @@unique([creatorId])
}

model AiConfiguration {
  id           String   @id @default(uuid())
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  //Relação com Group
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String @unique
}

model SchoolWebSite {
  id        String   @id @default(uuid())
  status    String
  data      Json
  url       String?
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação com as respostas dos formulários
  formResponses SchoolWebSiteFormResponse[]

  @@index([groupId])
}

// Respostas dos formulários da landing page das escolas
model SchoolWebSiteFormResponse {
  id              String        @id @default(uuid())
  schoolWebSite   SchoolWebSite @relation(fields: [schoolWebSiteId], references: [id], onDelete: Cascade)
  schoolWebSiteId String
  data            Json // Dados desestruturados do formulário
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([schoolWebSiteId])
}

// Permissões que usuários podem ter em grupos

enum GroupPermission {
  ADMIN
  TEACHER
  STUDENT
  DUPLICATE_CLASS
  REMOVE_USER
  ACCEPT_USER
  INVITE_USER
  EDIT_PERMISSION
  DELETED_USER
  WAITING_APPROVAL
}

enum CommunityPermission {
  ADMIN
  MEMBER
}

// Planos de grupos

enum GroupPlan {
  // Grátis
  FREE
  // Professores Premium
  PREMIUM
  // Professores + Alunos Premium
  ENTERPRISE
}

// Relaciona usuários e grupos 1 para n
// Cada usuário tem no máximo um grupo e cada grupo tem vários usuários
// Cada usuário pode ter várias permissões em um grupo

model UserGroup {
  id      String @id @default(uuid())
  user    User   @relation("UserGroupToUser", fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  group   Group  @relation("UserGroupToGroup", fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  // Permissões que usuários têm no grupo
  permissions GroupPermission[]
  createdAt   DateTime          @default(now())

  // Um usuário só pode estar em um único grupo
  @@unique([userId])
  @@unique([userId, groupId])
  @@index([groupId, userId])
}

enum GroupInvitationType {
  USER_REQUESTED_TO_JOIN
  USER_INVITED_TO_JOIN
}

enum GroupInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum StudentClassStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ClassInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GroupValidationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Convites enviados para grupos

model GroupInvitation {
  id        String                @id @default(uuid())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  group     Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  accepted  GroupInvitationStatus @default(PENDING)
  type      GroupInvitationType   @default(USER_REQUESTED_TO_JOIN)
  createdAt DateTime              @default(now())

  @@index([groupId])
  @@index([userId])
  @@index([groupId, userId])
}

// Convites enviados para turmas

model ClassInvitation {
  id        String                @id @default(uuid())
  student   Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  class     Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  accepted  ClassInvitationStatus @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([classId])
  @@index([classId, studentId])
}

model GroupValidationRequest {
  id        String                       @id @default(uuid())
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  group     Group                        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  role      String
  filesUrls String[]
  status    GroupValidationRequestStatus @default(PENDING)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
}

// Tipos de compartilhamento de turmas

enum ClassSharingType {
  // Permite duplicar a turma
  DUPLICATE
  // Permite visualizar as notas dos alunos
  GRADES
}

// Status possíveis de compartilhamento de turmas para pessoas

enum ClassSharingStatus {
  // Compartilhou acesso
  PENDING
  // Acesso aceito
  ACCEPTED
  // Acesso rejeitado
  REJECTED
}

// Turmas compartilhadas em um grupo

model GroupSharedClass {
  id        String             @id @default(uuid())
  group     Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  class     Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  types     ClassSharingType[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([groupId, classId])
}

// Turmas compartilhadas pra usuários

model IdentitySharedClass {
  id            String             @id @default(uuid())
  identity      Identity           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId    String
  class         Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId       String
  sharingStatus ClassSharingStatus
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([identityId, classId])
}

// Publicações compartilhadas em grupos

model GroupPost {
  id                String                @id @default(uuid())
  group             Group?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  // Se a publicação vai aparecer apenas para todos os usuários do grupo (public = false)
  // ou também para usuários de fora do grupo (public = true)
  public            Boolean               @default(false)
  // Se a publicação foi fixada
  pinned            Boolean               @default(false)
  // Título do post (Aparece em negrito)
  title             String?
  // Corpo do post (Não é markdown, é texto puro, permite pulo de linha)
  text              String?
  // Dono do post
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  // Um post pode ter vários arquivos
  files             PostFile[]
  contents          Content[]
  lesson            Lesson?               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId          String?
  ratings           GroupPostUserRating[]
  comments          GroupPostComment[]    @relation("PostComments")
  // Contagem acumulada de curtidas do post (Rating = 1)
  likesCount        Int                   @default(0)
  // Contagem acumulada de descurtidas do post (Rating = -1)
  dislikesCount     Int                   @default(0)
  // Contagem acumulada de comentários do post
  commentariesCount Int                   @default(0)
  isDeleted         Boolean               @default(false)
}

// Arquivos compartilhados em publicações de grupos

model PostFile {
  id       String    @id @default(uuid())
  // URL do arquivo no Bucket
  url      String
  // Tipo do arquivo, ex: "image/png", "image/jpeg", "document/pdf" etc.
  fileType String
  // Um arquivo pertence a exatamente um post, necessariamente
  post     GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  fileSize Int       @default(0)
}

model CommunityPostFile {
  id                    String                 @id @default(uuid())
  // URL do arquivo no Bucket
  url                   String
  // Tipo do arquivo, ex: "image/png", "image/jpeg", "document/pdf" etc.
  fileType              String
  // Um arquivo pertence a exatamente um post, necessariamente
  fileSize              Int                    @default(0)
  communityPosts        CommunityPost[]
  communityPostComments CommunityPostComment[]
}

// Likes, dislikes etc. de usuários em publicações de grupo

model GroupPostUserRating {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  // Nota do usuário para a publicação
  // 1 = Like, -1 = Dislike
  rate      Int       @default(1)
  createdAt DateTime  @default(now())

  @@unique([userId, postId])
}

// Comentários de usuários em publicações de grupo

model GroupPostComment {
  id            String                       @id @default(uuid())
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  text          String
  user          User                         @relation("CommentOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  post          GroupPost                    @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  postId        String
  // Futuramente os comentários em posts poderão ser respostas a outros comentários
  parent        GroupPostComment?            @relation("CommentReplies", fields: [parentId], references: [id])
  parentId      String?
  // Avaliações do comentário
  ratings       GroupPostCommentUserRating[]
  // Lista de comentários que são "filhos" do comentário em questão
  replies       GroupPostComment[]           @relation("CommentReplies")
  // Contagem acumulada de curtidas do comentário do post (Rating = 1)
  likesCount    Int                          @default(0)
  // Contagem acumulada de descurtidas do comentário do post (Rating = -1)
  dislikesCount Int                          @default(0)
  // Contagem acumulada de respostas do comentário do post
  repliesCount  Int                          @default(0)
  isDeleted     Boolean                      @default(false)
}

// Likes, dislikes etc. de usuários em publicações de grupo

model GroupPostCommentUserRating {
  id            String           @id @default(uuid())
