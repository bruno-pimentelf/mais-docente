model Certificate {
  id                String             @id @default(uuid())
  name              String
  code              String
  description       String?
  hours             Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userCertificates  UserCertificate[]
  certificateEmails CertificateEmail[]
}

model CertificateEmail {
  id            String      @id @default(uuid())
  email         String
  certificateId String
  dateCompleted DateTime?
  status        String
  createdAt     DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id])

  @@unique([email, certificateId])
}

model UserCertificate {
  id            String      @id @default(uuid())
  userId        String
  certificateId String
  dateCompleted DateTime?
  status        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate   Certificate @relation(fields: [certificateId], references: [id])

  @@unique([userId, certificateId])
  @@index([userId])
  @@index([certificateId])
}

model UserRewards {
  id     String           @id @default(uuid())
  userId String
  type   String
  status UserRewardStatus @default(READY_TO_REDEEM)
  user   User             @relation("UserRewardsToUser", fields: [userId], references: [id], onDelete: Cascade)
}

model UserBadges {
  id        String   @id @default(uuid())
  userId    String
  type      String
  count     Int      @default(1)
  level     Int      @default(1)
  user      User     @relation("UserBadgesToUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

model UserGoal {
  id         String         @id @default(uuid())
  goalId     String
  userId     String
  status     UserGoalStatus @default(FINISHED)
  goal       Goal           @relation(fields: [goalId], references: [id])
  startedAt  DateTime?
  finishedAt DateTime?
  user       User           @relation("UserGoalsToUser", fields: [userId], references: [id], onDelete: Cascade)

  // Add this index for queries filtering by userId
  @@unique([goalId, userId])
  @@index([userId])
}

model Goal {
  id          String     @id @default(uuid())
  name        String?
  description String?
  code        String?
  category    String?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
  goalDate    DateTime?
  users       UserGoal[]
}

// Tabela de relação de quem segue quem

model Follow {
  id          String   @id @default(uuid())
  followingId String // ID do usuário que está seguindo
  followerId  String // ID do usuário que é seguido
  createdAt   DateTime @default(now())
  following   User     @relation("UserFollows", fields: [followingId], references: [id], onDelete: Cascade)
  follower    User     @relation("UserFollowed", fields: [followerId], references: [id], onDelete: Cascade)

  // Cada par único de seguidor e seguido
  @@unique([followingId, followerId])
}

model RegisteredSchool {
  id                           Int              @id @default(autoincrement())
  placeId                      String?          @unique
  inepId                       String?
  nome                         String
  endereco                     String?
  codCidade                    Int?
  cidade                       String?
  estado                       String?
  regiao                       String?
  codPais                      String           @default("BR")
  pais                         Country          @relation(fields: [codPais], references: [code])
  situacaoFuncionamento        Int?
  dependenciaAdministrativa    Int?
  latitude                     Float?
  longitude                    Float?
  idebAI                       Float?
  idebAF                       Float?
  enemMediaGeral               Float?
  situacaoFuncionamentoTxt     String?
  dependenciaAdministrativaTxt String?
  users                        User[]
  // Grupo de usuário associado a escola registrada
  groups                       Group[]
  GuardianAccess               GuardianAccess[]
}

model Country {
  code    String             @id
  name    String
  schools RegisteredSchool[]
  users   User[]
  skill   Skill[]

  @@unique([code])
}

model Tutorial {
  id        String       @id @default(uuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      TutorialType
  skipped   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([userId, type])
}

model Notification {
  id     String           @id @default(uuid())
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  type   NotificationType
  viewed Boolean          @default(false)
  data   Json
}

model Referral {
  id                   String      @id @default(uuid())
  referrerId           String
  referrer             Identity    @relation("ReferrerToReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referrerBonusLimitId String?     @unique
  referrerBonusLimit   BonusLimit? @relation("ReferrerBonusToReferral", fields: [referrerBonusLimitId], references: [id], onDelete: Cascade)
  referrerCouponId     String?     @unique
  referrerCoupon       Coupon?     @relation("ReferrerCouponToReferral", fields: [referrerCouponId], references: [id], onDelete: Cascade)
  referredId           String      @unique
  referred             Identity    @relation("ReferredToReferral", fields: [referredId], references: [id], onDelete: Cascade)
  referredBonusLimitId String?     @unique
  referredBonusLimit   BonusLimit? @relation("ReferredBonusToReferral", fields: [referredBonusLimitId], references: [id], onDelete: Cascade)
  referredCouponId     String?     @unique
  referredCoupon       Coupon?     @relation("ReferredCouponToReferral", fields: [referredCouponId], references: [id], onDelete: Cascade)
  createdAt            DateTime?   @default(now())
}

model Coupon {
  id                     String       @id @default(uuid())
  stripeCouponId         String?
  owner                  Identity     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId                String
  createdAt              DateTime     @default(now())
  status                 CouponStatus @default(Pending)
  redeemedAt             DateTime?
  ReferrerCouponReferral Referral?    @relation("ReferrerCouponToReferral")
  ReferredCouponReferral Referral?    @relation("ReferredCouponToReferral")
  type                   CouponType   @default(TenReaisCredit)
  actionType             ActionType?
}

model NPSScore {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?
  type        String
  score       Int?
  note        String?
  nOfRetries  Int
  lastRetried DateTime  @default(now())

  @@index([userId])
}

model Tag {
  id            String             @id @default(uuid())
  name          String
  slug          String             @unique
  user          User?              @relation(fields: [userId], references: [id])
  userId        String?
  public        Boolean?           @default(false)
  questions     Question[]
  mockExamType  MockExamType[]
  entranceExams EntranceExamType[]
  locale        Locale
}

model SchoolLevel {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  grades Grade[]
  locale Locale
}

model Grade {
  id                   String                 @id
  name                 String
  order                Int
  locale               Locale
  questions            Question[]
  disciplines          Discipline[]
  users                User[]
  category             Category[]
  classes              Class[]
  mockExamType         MockExamType[]
  CalendarPlan         CalendarPlan[]
  schoolLevel          SchoolLevel            @relation(fields: [schoolLevelId], references: [id])
  schoolLevelId        String
  available            Boolean                @default(false)
  slug                 String                 @unique
  skills               Skill[]
  Lesson               Lesson[]
  toolsRecommendations AiToolRecommendation[]
  contents             Content[]

  StudyPlan StudyPlan[]
}

model Source {
  id            String             @id @default(uuid())
  name          String             @unique
  slug          String             @unique
  locale        Locale
  questions     Question[]
  mockExamType  MockExamType[]
  entranceExams EntranceExamType[]
}

model Discipline {
  id                     String                   @id @default(uuid())
  name                   String
  slug                   String?                  @unique
  internationalSlug      String?
  initials               String?                  @unique
  available              Boolean?                 @default(false)
  color                  String?
  locale                 Locale
  type                   DisciplineType           @default(NationalCommonBase)
  categories             Category[]
  grades                 Grade[]
  topics                 Topic[]
  users                  User[]
  assignments            Assignment[]
  questions              Question[]
  lists                  List[]
  disciplineMockExamType DisciplineMockExamType[]
  lessons                Lesson[]
  CalendarPlan           CalendarPlan[]
  practices              Practice[]
  entranceExams          EntranceExamType[]
  skills                 Skill[]
  communityPosts         CommunityPost[]
  toolsRecommendations   AiToolRecommendation[]
  PaidContent            PaidContent[]
  teacherClassDiscipline TeacherClassDiscipline[]
  contents               Content[]
}

model QuestionFilter {
  list       List       @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId     String     @unique
  categories Category[]
}

model Category {
  id                   String             @id @default(uuid())
  name                 String
  keywords             String[]
  slug                 String             @unique
  level                Int
  bncc                 String[]
  grade                Grade              @relation(fields: [gradeId], references: [id])
  gradeId              String
  questions            Question[]
  discipline           Discipline         @relation(fields: [disciplineId], references: [id])
  disciplineId         String
  topic                Topic?             @relation(fields: [topicId], references: [id])
  topicId              String?
  QuestionFilter       QuestionFilter?    @relation(fields: [questionFilterListId], references: [listId])
  questionFilterListId String?
  contents             Content[]
  description          String             @default("")
  projects             Project[]
  lessons              Lesson[]
  averageTime          Float
  relevance            Int                @default(3)
  CategoryDuration     CategoryDuration[]
  practices            Practice[]
  originalCategoryId   String?
  isDeleted            Boolean            @default(false)
  type                 CategoryType
  mainId               String
  updatedAt            DateTime           @default(now()) @updatedAt

  @@index([disciplineId])
}

model Topic {
  id           String     @id @default(uuid())
  name         String
  discipline   Discipline @relation(fields: [disciplineId], references: [id])
  disciplineId String
  categories   Category[]

  @@unique([name, disciplineId])
}

model Question {
  id                         String                 @id @default(uuid())
  title                      String?
  category                   Category?              @relation(fields: [categoryId], references: [id])
  categoryId                 String?
  discipline                 Discipline?            @relation(fields: [disciplineId], references: [id])
  disciplineId               String?
  description                String
  explanation                String?
  verified                   Boolean?               @default(false)
  goldStandard               Boolean?               @default(false)
  answer                     String
  alternatives               String[]
  image                      String?
  archived                   Boolean?               @default(false)
  user                       User                   @relation(fields: [userId], references: [id])
  userId                     String
  public                     Boolean?               @default(false)
  tags                       Tag[]
  difficulty                 Int
  source                     Source                 @relation(fields: [sourceId], references: [id])
  sourceId                   String
  year                       Int                    @default(2025)
  sourceQuestionNumber       Int?
  originalId                 String?                @unique
  createdAt                  DateTime               @default(now())
  modifiedAt                 DateTime               @updatedAt
  madeByAI                   Boolean?               @default(false)
  aiModel                    AiModel?
  madeByAdminEditor          Boolean?               @default(false)
  questionOnLists            QuestionOnList[]
  grades                     Grade[]
  questionReport             QuestionReport[]
  userRateQuestion           UserRateQuestion[]
  answerType                 AnswerType             @default(MultipleChoice)
  questionOnAssignment       QuestionOnAssignment[]
  resolutions                Resolution[]
  practiceResolutions        PracticeResolution[]
  practices                  Practice[]
  slug                       String?                @unique
  criteria                   QuestionCriterion[]
  textSupportId              String?
  textSupport                TextSupport?           @relation(fields: [textSupportId], references: [id])
  // Todas as traduções de questão
  translatedQuestions        Question[]             @relation("TranslationRelation")
  // Conteúdo do qual esse conteúdo foi traduzido
  originalQuestion           Question?              @relation("TranslationRelation", fields: [originalQuestionId], references: [id])
  originalQuestionId         String?
  aiToolGenerated            Boolean?               @default(false)
  locale                     Locale?
  reviewedBy                 QuestionRevision[]
  qualityScore               Float                  @default(0)
  keywords                   String[]
  topic                      String?
  educationLevel             Int?
  modelVersion               String?
  sourceOriginalTestPath     String?
  sourceOriginalSolutionPath String?
  skills                     QuestionSkill[]

  // Link to the latest revision
  latestRevision   QuestionRevision?  @relation("LatestRevision", fields: [latestRevisionId], references: [id])
  latestRevisionId String?            @unique
  QuestionSkillLog QuestionSkillLog[]

  @@index([sourceId])
  @@index([disciplineId, categoryId])
  @@index([categoryId])
  @@index([userId])
}

model QuestionRevision {
  id           String             @id @default(uuid())
  question     Question           @relation(fields: [questionId], references: [id])
  questionId   String
  status       VerificationStatus @default(Unverified)
  revisionDate DateTime           @default(now())
  reviewer     User               @relation(fields: [reviewerId], references: [id])
  reviewerId   String

  // Relation for the latest revision
  latestForQuestion Question? @relation("LatestRevision")
}

model Practice {
  id              String               @id @default(uuid())
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  type            PracticeType
  questions       Question[]
  createdAt       DateTime             @default(now())
  modifiedAt      DateTime?
  deletedAt       DateTime?
  resolutions     PracticeResolution[]
  grade           Int?
  disciplines     Discipline[]
  categories      Category[]
  contents        Content[]
  practiceEvent   PracticeEvent?
  practiceEventId String?
}

model PracticeResolution {
  id         String    @id @default(uuid())
  student    Student   @relation(fields: [studentId], references: [id])
  studentId  String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  practiceId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  answer     String
  timeSpent  DateTime? @db.Time
  createdAt  DateTime  @default(now())
  modifiedAt DateTime?
  deletedAt  DateTime?
}

model PracticeEvent {
  id         String       @id @default(uuid())
  student    Student      @relation(fields: [studentId], references: [id])
  studentId  String
  practice   Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  practiceId String       @unique
  startTime  DateTime
  endTime    DateTime
  plan       PracticePlan @relation(fields: [planId], references: [id])
  planId     String
}

model PracticePlan {
  id        String          @id @default(uuid())
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  events    PracticeEvent[]
  createdAt DateTime        @default(now())
}

model Statement {
  id        String   @id @default(uuid())
  title     String
  markdown  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  classes   Class[]
  createdAt DateTime @default(now())
}

model TextSupport {
  id        String     @id @default(uuid())
  text      String
  questions Question[]
  image     String?
}

model QuestionCriterion {
  id                             String                @id @default(uuid())
  name                           String
  weight                         Decimal
  rubricCriterionId              String?
  question                       Question?             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId                     String?
  questionOnAssignment           QuestionOnAssignment? @relation(fields: [assignmentId, questionOnAssignmentQuestionId], references: [assignmentId, questionId])
  assignmentId                   String?
  questionOnAssignmentQuestionId String?
  questionOnList                 QuestionOnList?       @relation(fields: [listId, questionOnListQuestionId], references: [listId, questionId])
  listId                         String?
  questionOnListQuestionId       String?
  CriterionCorrection            CriterionCorrection[]

  @@unique([assignmentId, questionOnAssignmentQuestionId, rubricCriterionId])
  @@index([rubricCriterionId])
}

model List {
  id                      String                  @id @default(uuid())
  title                   String
  description             String?
  questions               QuestionOnList[]
  user                    User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String?
  createdAt               DateTime                @default(now())
  modifiedAt              DateTime                @updatedAt
  questionFilter          QuestionFilter?
  questionFilterListId    String?
  initialDifficulty       Int?
  disciplines             Discipline[]
  listType                ListType?               @default(List)
  tasks                   Task[]
  public                  Boolean                 @default(false)
  isGeneratedFromOpenPage Boolean                 @default(false)
  isDeleted               Boolean                 @default(false)
  isGeneratingSkills      Boolean                 @default(false)
  instructions            String?
  timeLimit               Int?
  content                 Content?                @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId               String?                 @unique
  creatorUserType         UserTypeClassification?
  questionOnListSkills    QuestionOnListSkill[]
}

model QuestionOnList {
  list                     List                      @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId                   String
  question                 Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId               String
  position                 Int                       @default(0)
  weight                   Decimal?                  @default(1)
  createdAt                DateTime                  @default(now())
  modifiedAt               DateTime                  @updatedAt
  type                     AnswerType?
  customAnswer             String?
  customCriteria           QuestionCriterion[]
  discursiveCorrectionType DiscursiveCorrectionType? @default(Explanation)
  user                     User?                     @relation(fields: [userId], references: [id])
  userId                   String?
  skills                   QuestionOnListSkill[]
  rubricId                 String?
  rubric                   Rubric?                   @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  @@id([listId, questionId])
  @@index([userId, questionId])
  @@index([rubricId])
}

model Assignment {
  id                         String                      @id @default(uuid())
  title                      String
  instructions               String?
  questions                  QuestionOnAssignment[]
  user                       User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                     String?
  discipline                 Discipline?                 @relation(fields: [disciplineId], references: [id])
  disciplineId               String?
  timeLimit                  Int?
  createdAt                  DateTime                    @default(now())
  modifiedAt                 DateTime                    @updatedAt
  attemptsType               AttemptType                 @default(Virtual)
  attempts                   Attempt[]
  resolutions                Resolution[]
  shortLinks                 ShortLink?
  classes                    AssignmentClass[]
  task                       Task?
  numPages                   Int?
  shouldGradeAutomatically   Boolean                     @default(true)
  public                     Boolean                     @default(false)
  isDeleted                  Boolean                     @default(false)
  assignmentType             ListType?                   @default(Assignment)
  assignmentPerStudents      AssignmentPerStudent[]
  shuffleType                ShuffleType                 @default(None)
  assignmentMemory           AssignmentMemory?
  questionOnAssignmentSkills QuestionOnAssignmentSkill[]
}

model ManualAssignment {
  id          String                  @id @default(uuid())
  title       String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime                @default(now())
  modifiedAt  DateTime                @updatedAt
  isDeleted   Boolean                 @default(false)
  totalPoints Decimal                 @default(0)
  classes     ManualAssignmentClass[]
  grades      ManualAssignmentGrade[]

  @@index([createdAt])
}

model ManualAssignmentClass {
  id                 String           @id @default(uuid())
  manualAssignment   ManualAssignment @relation(fields: [manualAssignmentId], references: [id])
  manualAssignmentId String
  class              Class            @relation(fields: [classId], references: [id])
  classId            String
  weight             Decimal

  @@unique([manualAssignmentId, classId])
  @@index([classId])
  @@index([manualAssignmentId])
}

model ManualAssignmentGrade {
  id                 String           @id @default(uuid())
  manualAssignment   ManualAssignment @relation(fields: [manualAssignmentId], references: [id])
  manualAssignmentId String
  student            Student          @relation(fields: [studentId], references: [id])
  studentId          String
  grade              Decimal

  @@index([studentId, manualAssignmentId])
}

model AssignmentPerStudent {
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  code         String     @unique

  @@id([assignmentId, studentId])
}

model ShortLink {
  id             String     @id @default(uuid())
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId   String     @unique
  shortLink      String
  expirationDate DateTime
}

model QuestionOnAssignment {
  assignment               Assignment                  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId             String
  question                 Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId               String
  weight                   Decimal
  position                 Int                         @default(0)
  createdAt                DateTime                    @default(now())
  modifiedAt               DateTime                    @updatedAt
  type                     AnswerType?
  customAnswer             String?
  customCriteria           QuestionCriterion[]
  Resolution               Resolution[]
  discursiveCorrectionType DiscursiveCorrectionType?
  skills                   QuestionOnAssignmentSkill[]
  rubricId                 String?
  rubric                   Rubric?                     @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  @@id([assignmentId, questionId])
  @@index([rubricId])
}

model Attempt {
  id                String          @id @default(uuid())
  assignment        Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId      String
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         String?
  taskId            String?
  identification    String
  createdAt         DateTime        @default(now())
  modifiedAt        DateTime        @updatedAt
  resolutions       Resolution[]
  stateCorrection   StateCorrection @default(NotStarted)
  isGradingComplete Boolean         @default(false)
  sentToWorkerAt    DateTime?
  gradedByWorkerAt  DateTime?
  studentTask       StudentTask?    @relation(fields: [taskId, studentId], references: [taskId, studentId], onDelete: Cascade)
  type              AttemptType     @default(Virtual)
  paperPages        PaperPage[]
  reviewedByTeacher Boolean         @default(true)

  @@index([stateCorrection])
  @@index([studentId, assignmentId])
  @@index([studentId, stateCorrection])
  @@index([studentId, createdAt])
}

model PaperPage {
  id         String    @id @default(uuid())
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  String
  url        String
  number     Int
  createdAt  DateTime  @default(now())
  modifiedAt DateTime? @updatedAt
  isDeleted  Boolean   @default(false)
}

model Resolution {
  id                   String                @id @default(uuid())
  attempt              Attempt               @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId            String
  question             Question              @relation(fields: [questionId], references: [id])
  questionOnAssignment QuestionOnAssignment? @relation(fields: [assignmentId, questionId], references: [assignmentId, questionId])
  questionId           String
  answer               String
  position             Int
  timeSpent            DateTime?             @db.Time
  imagePath            String?
  assignment           Assignment            @relation(fields: [assignmentId], references: [id])
  assignmentId         String
  correction           Correction?
}

model Correction {
  id                   String                @id @default(uuid())
  resolution           Resolution            @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  resolutionId         String                @unique
  commentary           String?
  value                Decimal?
  absoluteValue        Decimal?
  correctness          Correctness?
  criterionCorrections CriterionCorrection[]
  quotedFeedbacks      QuotedFeedback[]
}

model CriterionCorrection {
  id            String            @id @default(uuid())
  criterion     QuestionCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  criterionId   String
  feedback      String?
  absoluteValue Decimal           @default(0)
  completion    Correctness       @default(NotGraded)
  correction    Correction?       @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  correctionId  String
  createdAt     DateTime          @default(now())
  modifiedAt    DateTime          @updatedAt

  @@unique([criterionId, correctionId])
  @@index([correctionId])
}

model QuotedFeedback {
  id           String      @id @default(uuid())
  quote        String
  feedback     String
  quoteIndexes Int[]       @default([])
  correction   Correction? @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  correctionId String
  madeByAI     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  modifiedAt   DateTime    @updatedAt
}

model ProjectViewed {
  id        String @id @default(uuid())
  projectId String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId, projectId])
}

model Project {
  id                 String                 @id @default(uuid())
  title              String?
  slug               String?
  description        String?
  markdown           String
  url                String?
  difficulty         Int?
  type               ProjectType
  numberOfStudents   NumberOfStudents
  category           Category?              @relation(fields: [categoryId], references: [id])
  categoryId         String?
  categoryText       String?
  users              UserFavoritesProject[]
  createdAt          DateTime               @default(now())
  modifiedAt         DateTime               @updatedAt
  isDeleted          Boolean                @default(false)
  public             Boolean?               @default(false)
  verified           Boolean?               @default(false)
  reviewer           User?                  @relation("contentReviewer", fields: [reviewerId], references: [id])
  reviewerId         String?
  content            Content?               @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId          String?                @unique
  ProjectTask        ProjectTask[]
  creator            User?                  @relation(fields: [creatorId], references: [id])
  creatorId          String?
  ownerType          ContentOwnerType       @default(MaisDocente)
  // Todas as traduções de projeto
  translatedProjects Project[]              @relation("TranslationRelation")
  // Projeto do qual esse conteúdo foi traduzido
  originalProject    Project?               @relation("TranslationRelation", fields: [originalProjectId], references: [id])
  originalProjectId  String?
  criteria           ProjectCriterion[]
  rubric             Rubric?                @relation(fields: [rubricId], references: [id])
  rubricId           String?
}

model ProjectCriterion {
  id             String               @id @default(uuid())
  name           String
  type           ProjectCriterionType
  weight         Decimal
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String?
  criteriaType   CriteriaType?        @relation(fields: [criteriaTypeId], references: [id])
  criteriaTypeId String?

  @@index([projectId])
}

model CriteriaType {
  id       String             @id @default(uuid())
  name     String
  locale   Locale
  criteria ProjectCriterion[]
}

enum RubricType {
  ESSAY
  QUESTION
  PROJECT
}

model Rubric {
  id                    String                 @id @default(uuid())
  name                  String?
  locale                Locale
  type                  RubricType             @default(ESSAY)
  criteria              RubricCriterion[]
  owner                 ContentOwnerType       @default(MaisDocente)
  Project               Project[]
  ProjectTask           ProjectTask[]
  GradedRubric          GradedRubric[]
  questionOnLists       QuestionOnList[]
  questionOnAssignments QuestionOnAssignment[]
  isDeleted             Boolean                @default(false)
  createdAt             DateTime?              @default(now())
  modifiedAt            DateTime?              @updatedAt
  user                  User?                  @relation(fields: [userId], references: [id])
  userId                String?

  @@index([type])
}

model RubricCriterion {
  id         String                @id @default(uuid())
  name       String
  rubric     Rubric                @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  rubricId   String
  pointScale CriterionPointScale[]
}

model CriterionPointScale {
  id                String           @id @default(uuid())
  description       String
  weight            Decimal
  RubricCriterion   RubricCriterion? @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  rubricCriterionId String?
}

model UserFavoritesProject {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())

  @@id([userId, projectId])
}

model UrlShortener {
  alias String          @id @default(uuid())
  ref   URLShortenerRef
  data  Json
}

model ProjectTask {
  id                       String                  @id @default(uuid())
  title                    String
  project                  Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId                String
  teacher                  User                    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId                String
  createdAt                DateTime                @default(now())
  modifiedAt               DateTime                @updatedAt
  criteria                 ProjectTaskCriterion[]
  classes                  ProjectTaskClass[]
  dueDate                  DateTime?
  task                     Task?
  ProjectTaskResolution    ProjectTaskResolution[]
  durationInMinutes        Int?
  type                     ProjectTaskType?
  rubric                   Rubric?                 @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  rubricId                 String?
  shouldGradeAutomatically Boolean                 @default(true)
}

model ProjectTaskCriterion {
  id                             String                           @id @default(uuid())
  name                           String
  type                           ProjectCriterionType
  weight                         Decimal
  projectTask                    ProjectTask                      @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)
  projectTaskId                  String
  ProjectTaskCriterionCorrection ProjectTaskCriterionCorrection[]
}

model ProjectTaskClass {
  class               Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId             String
  projectTask         ProjectTask @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)
  projectTaskId       String
  weight              Float?
  includeInFinalGrade Boolean     @default(true)

  @@id([classId, projectTaskId])
  @@index([classId, includeInFinalGrade])
  @@index([projectTaskId])
}

model ProjectTaskResolution {
  id                String                           @id @default(uuid())
  studentTask       StudentTask?                     @relation(fields: [taskId, studentId], references: [taskId, studentId], onDelete: Cascade)
  taskId            String?
  studentId         String?
  projectTask       ProjectTask                      @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)
  projectTaskId     String
  files             ProjectTaskResolutionFile[]
  grade             Decimal?
  createdAt         DateTime                         @default(now())
  modifiedAt        DateTime                         @updatedAt
  isGradingComplete Boolean                          @default(false)
  sentToWorkerAt    DateTime?
  gradedByWorkerAt  DateTime?
  stateCorrection   StateCorrection                  @default(NotStarted)
  corrections       ProjectTaskCriterionCorrection[]
  essay             String?
  feedbacks         ProjectTaskCorrectionFeedback[]
  commentary        String?
  gradedRubric      GradedRubric[]
  reviewedByTeacher Boolean                          @default(true)

  @@index([stateCorrection, projectTaskId])
  @@index([studentId, projectTaskId])
  @@index([studentId, stateCorrection])
  @@index([studentId, createdAt])
}

model GradedRubric {
  id                      String                 @id @default(uuid())
  chosenPoints            Decimal?
  explanation             String?
  criterion               String?
  ProjectTaskResolution   ProjectTaskResolution? @relation(fields: [projectTaskResolutionId], references: [id], onDelete: Cascade)
  projectTaskResolutionId String?
  Rubric                  Rubric?                @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  rubricId                String?
}

model ProjectTaskCorrectionFeedback {
  id                      String                @id @default(uuid())
  startAt                 Int
  endAt                   Int
  feedback                String
  type                    String?
  projectTaskResolution   ProjectTaskResolution @relation(fields: [projectTaskResolutionId], references: [id], onDelete: Cascade)
  projectTaskResolutionId String
  createdAt               DateTime              @default(now())
  modifiedAt              DateTime              @updatedAt
}

model ProjectTaskResolutionFile {
  id                      String                @id @default(uuid())
  projectTaskResolution   ProjectTaskResolution @relation(fields: [projectTaskResolutionId], references: [id], onDelete: Cascade)
  projectTaskResolutionId String
  title                   String
  plainText               String
  markdown                String
  url                     String
  extension               Extension
  createdAt               DateTime              @default(now())
  modifiedAt              DateTime              @updatedAt
}

model ProjectTaskCriterionCorrection {
  projectTaskCriterion    ProjectTaskCriterion  @relation(fields: [projectTaskCriterionId], references: [id], onDelete: Cascade)
  projectTaskCriterionId  String
  commentary              String?
  value                   Decimal?
  projectTaskResolution   ProjectTaskResolution @relation(fields: [projectTaskResolutionId], references: [id], onDelete: Cascade)
  projectTaskResolutionId String
  createdAt               DateTime              @default(now())
  modifiedAt              DateTime              @updatedAt

  @@id([projectTaskCriterionId, projectTaskResolutionId])
}

model QuestionReport {
  id          String   @id @default(uuid())
  description String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime @default(now())
  modifiedAt  DateTime @updatedAt
  solved      Boolean? @default(false)
  archived    Boolean? @default(false)
}

model UserRateQuestion {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  rating     Int

  @@id([userId, questionId])
}

model BlogPost {
  id             String          @id @default(uuid())
  title          String
  description    String
  author         String
  slug           String          @unique
  content        String
  blogTopics     BlogTopic[]
  uploadedImages UploadedImage[]
  mainImageSlug  String?
  featured       Boolean?        @default(false)
  createdAt      DateTime        @default(now())
  modifiedAt     DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  active         Boolean?        @default(true)
  archived       Boolean?        @default(false)
}

model BlogTopic {
  id        String     @id @default(uuid())
  name      String
  blogPosts BlogPost[]
}

model Skill {
  id              String       @id @default(uuid())
  code            String
  description     String
  longDescription String?
  grades          Grade[]
  disciplines     Discipline[]
  locale          Locale
  type            SkillType
  lessons         Lesson[]
  country         Country?     @relation(fields: [countryCode], references: [code])
  countryCode     String?

  // Explicit intermediate tables for skill relations
  questionSkills             QuestionSkill[]
  questionOnListSkills       QuestionOnListSkill[]
  questionOnAssignmentSkills QuestionOnAssignmentSkill[]

  // Counts how many times this skill was added to a question by a user
  questionSkillLog QuestionSkillLog[]

  @@unique([code])
}

// Log of skills added to a question by a user
model QuestionSkillLog {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@id([questionId, skillId, userId])
  @@index([questionId, skillId]) // For counting skills per question
  @@index([skillId, questionId]) // For finding questions by skill
}

// Intermediate table for Question-Skill relation
model QuestionSkill {
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  skill      Skill    @relation(fields: [skillCode], references: [code], onDelete: Cascade)
  skillCode  String

  @@id([questionId, skillCode])
  @@index([skillCode]) // For queries filtering by skill
}

// Intermediate table for QuestionOnList-Skill relation
model QuestionOnListSkill {
  list           List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId         String
  questionId     String
  questionOnList QuestionOnList @relation(fields: [listId, questionId], references: [listId, questionId], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillCode], references: [code], onDelete: Cascade)
  skillCode      String

  @@id([listId, questionId, skillCode])
  @@index([skillCode]) // For queries filtering by skill
  @@index([listId, skillCode]) // For list-level skill queries
}

// Intermediate table for QuestionOnAssignment-Skill relation
model QuestionOnAssignmentSkill {
  assignment           Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId         String
  questionId           String
  questionOnAssignment QuestionOnAssignment @relation(fields: [assignmentId, questionId], references: [assignmentId, questionId], onDelete: Cascade)
  skill                Skill                @relation(fields: [skillCode], references: [code], onDelete: Cascade)
  skillCode            String

  @@id([assignmentId, questionId, skillCode])
  @@index([skillCode]) // For queries filtering by skill
  @@index([assignmentId, skillCode]) // For assignment-level skill queries
}

model Bncc {
  id                 String   @id @default(uuid())
  skills             String
  stage              String
  year               String[]
  code               String
  comment            String?
  fields_of_activity String?
  component          String?
  units              String?
  objects            String?
  possibilities      String?
  competencies       String?

